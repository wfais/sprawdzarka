# Skopiuj ten plik jako .env i uzupelnij wartosci. Plik .env nigdy nie trafia do repozytorium.

# --- Django ---
# Dlugi losowy ciag znakow, np. wynik polecenia:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
# 1 tylko na wlasnym komputerze (tryb deweloperski), na serwerze 0
DJANGO_DEBUG=1
# Nazwy hostow, pod ktorymi dziala serwis (oddzielone przecinkami)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Publiczny adres serwisu bez ukosnika na koncu. Z niego budowane sa linki dla studentow
# i adres powrotu z logowania GitHub (musi sie zgadzac z ustawieniami aplikacji GitHub).
PUBLICZNY_ADRES=http://localhost:8000

# --- Baza danych ---
# Puste = SQLite w katalogu dane/ (wystarczy lokalnie). docker-compose ustawia PostgreSQL sam.
DATABASE_URL=

# --- Aplikacja GitHub (instrukcja: docs/aplikacja-github.md) ---
GITHUB_ORG=wfais
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY_PATH=dane/github-app.pem
GITHUB_WEBHOOK_SECRET=
# Opcjonalnie: numer instalacji aplikacji (puste = wykrywany automatycznie)
GITHUB_INSTALLATION_ID=

# --- Ocena automatyczna: modele jezykowe ---
# Lista modeli dostawca:nazwa oddzielona przecinkami. Dostawcy: anthropic, openai, xai, openrouter, demo.
# Nazwy modeli sprawdz w dokumentacji dostawcy. Przyklady:
#   OCENIAJACE_MODELE=anthropic:claude-sonnet-5-5,openai:NAZWA,xai:NAZWA
#   OCENIAJACE_MODELE=openrouter:anthropic/NAZWA,openrouter:openai/NAZWA
#   OCENIAJACE_MODELE=demo:a,demo:b,demo:c        (wyprobowanie bez kluczy, oceny na niby)
OCENIAJACE_MODELE=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=
OPENROUTER_API_KEY=

# --- Ocena automatyczna: testy ---
# wylaczone : bez testow (domyslnie)
# kolejka   : pytest uruchamia osobny proces bez sieci i kluczy (docker-compose ustawia to sam; zalecane)
# lokalnie  : pytest uruchamia robot na Twoim koncie. UWAGA: kod studenta ma wtedy dostep do Twoich plikow
#             (w tym .env i klucza aplikacji GitHub) i do sieci. Tylko do prob na wlasnych, zaufanych przykladach!
SPRAWDZARKA_TESTY=wylaczone
# Limit czasu testow jednej pracy (sekundy)
SPRAWDZARKA_LIMIT_TESTOW=120
# Dokladnosc punktow i tolerancja sporu miedzy modelami
SPRAWDZARKA_KROK_PUNKTOW=0.25
SPRAWDZARKA_TOLERANCJA_BEZWZGLEDNA=0.25
SPRAWDZARKA_TOLERANCJA_WZGLEDNA=0.2

# --- Tylko dla docker-compose ---
POSTGRES_PASSWORD=
# Domena serwera (dla HTTPS przez Caddy, profil "serwer")
DOMENA=sprawdzarka.example.edu.pl
# Na jakim adresie wystawic port 8000: 127.0.0.1 (tylko ten komputer) albo 0.0.0.0 (cala siec lokalna)
ADRES_WEB=127.0.0.1
